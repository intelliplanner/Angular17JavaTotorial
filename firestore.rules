rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions is list &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.hasAny(['*', 'admin']);
    }

    function ownsConnectedProjectRecord() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.userIdentifier ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /passwordUniqueness/{digest} {
      allow read, write: if false;
    }

    match /connectedProjects/{projectId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || ownsConnectedProjectRecord();
      allow delete: if isAdmin();
    }

    match /userSettings/{settingId} {
      allow read, write: if signedIn();
    }

    match /{collection}/{document} {
      allow read: if signedIn() &&
        collection in ['tutorials', 'notes', 'questions', 'answers', 'quizzes', 'categories', 'jsonFiles'];
      allow write: if isAdmin() &&
        collection in ['tutorials', 'notes', 'questions', 'answers', 'quizzes', 'categories', 'jsonFiles'];
    }
  }
}
